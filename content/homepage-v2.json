      "sha256": "706e6ca2e9453a7c0ca4b673763314cbe19b5c9746cfad54fd1bb3d21a193ef8"
    },
    {
      "id": "building.education.description",
      "section": "building",
      "kind": "text",
      "text": "A community of practice for learning, making, and helping one another build.",
      "sha256": "3cecb16236be3784ed8109462005bf27f59c349b8f34f741e245b3a6aa1ac518"
    },
    {
      "id": "building.engineering",
