  "items": [
    {
      "id": "identity",
      "section": "identity",
      "kind": "identity",
      "label": "Michael Darius",
      "sha256": "9f206fa06f18d36a27ae2a81b740403470b6d1725363959a8e54236babe7b2ad"
    },
    {
      "id": "identity.0",
      "section": "identity",
      "kind": "text",
      "text": "Designer. Builder. Educator.",
      "sha256": "e8290fffc97bfeeb7bac593ccb8702bbd31fb236e076f901ccb3cacbe137248b"
    },
    {
      "id": "identity.1",
      "section": "identity",
      "kind": "text",
      "text": "I help people turn meaningful ideas into things they can use.",
      "sha256": "f59ccefbbd89eeb9d890adf0c80bd4169806cbc8ac5eb6b0f1679d8e30e471d9"
    },
    {
      "id": "identity.2",
      "section": "identity",
      "kind": "text",
      "text": "My background includes contributions to Apple’s iTunes Music Store and early cloud services. Today I’m building Living Instruments and working across design, engineering, education, and storytelling.",
      "sha256": "638b649d429ac5303b6a25302c1dd99f188b2088b981f308b829bae42aa528fd"
    },
    {
      "id": "identity.3",
      "section": "identity",
      "kind": "text",
      "text": "I lead the work personally. From the first conversation through design, development, launch, and ongoing improvements, you work with me. When a project needs collaborators, we make their roles clear. You know who is responsible and how to reach us.",
      "sha256": "628f3945e46f7d5eded6fbf80bf3ff4f312fcfb574d0595162c040f0113b7af7"
    },
    {
      "id": "how.0",
      "section": "how",
      "kind": "text",
      "text": "We start with what you want to make possible. I help shape it into a clear scope, a practical plan, and something we can put in front of people.",
      "sha256": "ebc97a721b090c5c98ac6a22f0920d9b3beae690fdd729aecb8e1f3f0a38b8ca"
    },
    {
      "id": "how.1",
      "section": "how",
      "kind": "text",
      "text": "I like making ideas tangible early: a paper sketch, a clickable experience, working software. We look at it together, learn what matters, and keep improving it.",
      "sha256": "7753bcd6c8a63dc3a97d07d25363d11011aa084bc5825c5c8fff7f10834ef555"
    },
    {
      "id": "how.2",
      "section": "how",
      "kind": "text",
      "text": "There is serious thought behind the work. There should also be curiosity, good conversation, and some fun along the way.",
      "sha256": "4872fe0a1ad9d0e8dc1a8423c4b9185c654e6b7de57c1a5718387582d661f413"
    },
    {
      "id": "building.living",
